// Схема БД. Ключевые решения зафиксированы в AGENTS.md:
// - у записи два конца: endAt (конец сеанса) и blockedUntil (конец занятости с буфером);
// - непересечение активных записей гарантирует exclusion constraint из ручной миграции,
//   а не код приложения;
// - состояние диалога Telegraf лежит в BotSession, чтобы переживать перезапуск.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Состояние синхронизации с Google Calendar. Google может упасть уже после того,
/// как запись создана в БД, — запись при этом остаётся валидной.
enum GoogleSyncState {
  PENDING
  SYNCED
  FAILED
}

enum ExceptionType {
  /// выходной на весь день
  DAY_OFF
  /// другие рабочие часы вместо обычных для этого дня
  CUSTOM_HOURS
  /// заблокированный интервал внутри рабочего дня
  BLOCK
}

enum ReminderRecipient {
  CLIENT
  THERAPIST
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  name       String?
  phone      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]
}

model Service {
  id              String  @id @default(uuid())
  name            String
  durationMinutes Int
  bufferMinutes   Int     @default(0)
  /// цена в копейках, чтобы не хранить деньги во float
  price           Int?
  enabled         Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]
}

model Appointment {
  id        String @id @default(uuid())
  userId    String
  serviceId String

  /// начало сеанса
  startAt      DateTime @db.Timestamptz(3)
  /// конец сеанса: то, что видит клиент и что уходит в Google Calendar
  endAt        DateTime @db.Timestamptz(3)
  /// конец занятости: endAt + буфер услуги. По нему считается пересечение
  blockedUntil DateTime @db.Timestamptz(3)

  status          AppointmentStatus @default(CONFIRMED)
  googleEventId   String?
  googleSyncState GoogleSyncState   @default(PENDING)
  comment         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reminders Reminder[]

  @@index([startAt])
  @@index([status, startAt])
  @@index([userId, startAt])
}

/// Обычные рабочие часы. Несколько строк на один день = раздельные смены (10:00-13:00, 15:00-19:00).
model WorkingHours {
  id String @id @default(uuid())
  /// ISO-нумерация: 1 = понедельник ... 7 = воскресенье
  dayOfWeek Int
  /// локальное время в APP_TIMEZONE, формат "HH:mm"
  startTime String
  endTime   String
  enabled   Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([dayOfWeek, startTime])
  @@index([dayOfWeek])
}

model ScheduleException {
  id String @id @default(uuid())
  /// локальная календарная дата в APP_TIMEZONE
  date    DateTime      @db.Date
  type    ExceptionType
  /// для CUSTOM_HOURS — новые рабочие границы дня, для BLOCK — заблокированный интервал
  startAt DateTime?     @db.Timestamptz(3)
  endAt   DateTime?     @db.Timestamptz(3)
  comment String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([date])
}

model Reminder {
  id            String            @id @default(uuid())
  appointmentId String
  recipient     ReminderRecipient
  fireAt        DateTime          @db.Timestamptz(3)
  sentAt        DateTime?         @db.Timestamptz(3)
  failedAt      DateTime?         @db.Timestamptz(3)
  error         String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, recipient, fireAt])
  @@index([sentAt, fireAt])
}

/// Состояние сцен Telegraf. В памяти его держать нельзя: перезапуск ломает диалог.
model BotSession {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
