# --- Telegram ---
BOT_TOKEN=
# Telegram user ID массажиста (число). Узнать можно через @userinfobot
ADMIN_TELEGRAM_ID=

# --- База ---
# Вариант 1: postgres из docker compose (`npm run db:up`)
DATABASE_URL=postgresql://massage:massage@localhost:5433/massage_booking?schema=public
# Вариант 2: локально установленный postgres
# DATABASE_URL=postgresql://localhost:5432/massage_booking?schema=public

# --- Google Calendar (Этап 2) ---
# Календарь массажиста нужно расшарить на почту сервисного аккаунта
# с правом «Вносить изменения в мероприятия».
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Бизнес-логика ---
APP_TIMEZONE=Europe/Kyiv
# Шаг сетки предлагаемых слотов, минуты
SLOT_STEP_MINUTES=30
# На сколько дней вперёд клиент видит свободные слоты
BOOKING_HORIZON_DAYS=30
# Минимальный запас до начала сеанса, минуты
MIN_LEAD_TIME_MINUTES=120
# За сколько часов до сеанса клиент ещё может отменить / перенести сам
CANCEL_DEADLINE_HOURS=4
RESCHEDULE_DEADLINE_HOURS=4
# Сколько активных записей может держать один клиент
MAX_ACTIVE_APPOINTMENTS=3

# --- Напоминания (Этап 5) ---
# За сколько часов до сеанса напоминать, через запятую
REMINDER_CLIENT_HOURS=24,2
REMINDER_THERAPIST_HOURS=2
# Насколько просроченное напоминание ещё имеет смысл отправить после простоя, минуты
REMINDER_GRACE_MINUTES=30

# Через сколько дней без активности удалять брошенный диалог
SESSION_TTL_DAYS=30

# --- Тексты ---
CONTACTS_TEXT=Массажист Ирина\nTelegram: @example\nТелефон: +380 00 000 00 00
